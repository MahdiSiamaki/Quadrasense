<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sqm.Application\Sqm.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Client" Version="7.14.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- RAR only (ADR-025): GSMA delivers the TAC catalogue as .rar, and the runtime reads ZIP and
         gzip itself. Pinned: 0.50.7 is what was measured against the real archive. -->
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ClickHouse query runner is internal; its limits are tested against a real server. -->
    <InternalsVisibleTo Include="Sqm.Integration.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
