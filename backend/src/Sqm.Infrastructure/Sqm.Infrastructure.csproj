<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sqm.Application\Sqm.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Client" Version="7.14.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- RAR only (ADR-025): GSMA delivers the TAC catalogue as .rar, and the runtime reads ZIP and
         gzip itself. Pinned: 0.50.7 is what was measured against the real archive. -->
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <!-- The Persian captcha (ADR-026) is drawn on the server, so only a picture reaches the browser.
         SkiaSharp: System.Drawing is Windows-only, and ImageSharp's licence charges an organisation
         MCI's size. NoDependencies: its native library brings its own font handling, so the image
         needs no fontconfig - the typefaces are embedded below. -->
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The captcha's Persian typefaces, embedded so a read-only image needs no font directory.
         Their licences travel with them, as the OFL asks, into the output. -->
    <EmbeddedResource Include="Identity\Captcha\Fonts\*.ttf" LogicalName="Sqm.Captcha.Fonts.%(Filename)%(Extension)" />
    <None Include="Identity\Captcha\Fonts\*.txt" Link="licenses\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ClickHouse query runner is internal; its limits are tested against a real server. -->
    <InternalsVisibleTo Include="Sqm.Integration.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
